# Copia este archivo a .env y reemplaza todos los valores "change_me".
# .env esta ignorado por git; nunca lo comitees.

MYSQL_DATABASE=nexusmarket
MYSQL_APP_USER=change_me
MYSQL_APP_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PORT=3306

MONGO_DATABASE=nexusmarket
MONGO_ROOT_USERNAME=change_me
MONGO_ROOT_PASSWORD=change_me
MONGO_APP_USERNAME=change_me
MONGO_APP_PASSWORD=change_me
MONGO_PORT=27017
# Ajusta usuario, contrasena y authSource a los valores definidos arriba.
MONGODB_URI=mongodb://change_me:change_me@mongo:27017/nexusmarket?authSource=change_me
